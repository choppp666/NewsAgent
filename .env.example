# ==========================================================
# 每日 AI 新闻助手 - 环境变量示例
# 使用方法：复制本文件为 .env 后按需修改（.env 不要提交到 git）
# ==========================================================

# ---------- 应用基础配置 ----------
APP_NAME=每日 AI 新闻助手
APP_VERSION=0.1.0
# 开发环境建议开启（生产环境请设为 false，关闭 /docs 之外的调试信息）
DEBUG=true

# ---------- 数据库配置 ----------
# 默认使用项目根目录下的 data/news_agent.db
# 若使用相对路径（如 sqlite:///./data/news_agent.db），会以「项目根目录」为基准解析
DATABASE_URL=sqlite:///./data/news_agent.db
# 是否打印 SQL 语句（调试用，生产请关闭）
SQL_ECHO=false

# ---------- 服务监听配置 ----------
HOST=127.0.0.1
PORT=8000

# ---------- CORS 配置 ----------
# 多个来源用英文逗号分隔；仅本地开发可填 *，生产环境务必写具体域名
CORS_ORIGINS=*

# ---------- 大模型配置（第二阶段：Agent 核心） ----------
# 支持任意「OpenAI 兼容」接口：DeepSeek / 通义 / Kimi / vLLM / Ollama(/v1) 等
# 密钥不要写在这个文件里：把密钥放进 .env.local（已在 .gitignore 中）。
# 加载顺序是 .env → .env.local，后者覆盖前者，所以这里的空值不会盖掉你的密钥。
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# DeepSeek 示例（第三阶段实测所用）：
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_MODEL=deepseek-chat

# ---------- Agent 行为配置 ----------
# 模式：auto（有 key 走真实模型，没 key 自动降级 mock）/ openai / mock
# 注意：mock 仅用于验证工具注册与调用链路，不代表真实模型的决策能力
AGENT_MODE=auto
# Agent 沙箱工作区；留空 = <项目根>/workspace
AGENT_WORKSPACE=
# 单次任务最大 LLM 轮数（硬上限 20，防止无限调用）
AGENT_MAX_STEPS=8
# 单次任务最大工具调用次数（硬上限 50）
AGENT_MAX_TOOL_CALLS=20
# 单次任务整体超时（秒）
AGENT_RUN_TIMEOUT=120
# 单次 LLM 请求超时（秒）
AGENT_LLM_TIMEOUT=60
# LLM 失败重试次数
AGENT_LLM_RETRIES=2
# 采样温度
AGENT_TEMPERATURE=0.2
# bash 工具默认超时 / 最大超时（秒）
AGENT_BASH_TIMEOUT=10
AGENT_BASH_TIMEOUT_MAX=60
# bash 输出截断长度（字符）
AGENT_BASH_OUTPUT_LIMIT=8000
# read_file 单次读取上限（字节）
AGENT_READ_MAX_BYTES=200000
# list_dir 单次返回条目上限
AGENT_LIST_MAX_ENTRIES=200
# search_content 单次命中上限
AGENT_SEARCH_MAX_MATCHES=50
# write_file 单次写入上限（字节）
AGENT_WRITE_MAX_BYTES=200000
# 回填给 LLM 的单条工具结果最大长度（字符）
AGENT_TOOL_RESULT_LIMIT=12000
# 一次运行的工具结果总字符预算：超了就把最早的压缩成「标题+链接+摘要」（0 = 不压缩）
AGENT_CONTEXT_BUDGET_CHARS=40000
# 压缩时始终保留全文的最近 N 条工具结果（模型正在基于它们决策，不能压）
AGENT_TOOL_RESULT_KEEP_FULL=3
# 内存中保留的运行记录条数
AGENT_KEEP_RUNS=50

# 新闻搜索服务（如 NewsAPI / 博查 / Tavily 等）
# 第三阶段默认走 RSS，不需要这个 Key；接入商业搜索 API 时再填
NEWS_API_KEY=

# ---------- 第三阶段：新闻采集 ----------
# 搜索提供方：rss（默认）/ 任何通过 register_provider() 注册的名字
# 接入 NewsAPI、博查、Tavily 或模型内置 Web Search 后改这里即可全局切换
NEWS_PROVIDER=rss
# 启用的 RSS 源 ID（逗号分隔），留空使用内置 10 个源
# 可用：qbitai / leiphone / geekpark / ithome / openai / googleai /
#       huggingface / techcrunch-ai / simonw / marktechpost
NEWS_FEEDS=
# 单个源最多读取条数
NEWS_MAX_ITEMS_PER_FEED=30
# RSS 抓取缓存时长（秒）：一次生成会多次搜索，缓存避免每次都把 10 个源重新下载；0 = 关闭
NEWS_FEED_CACHE_TTL=300
# 抓取超时（秒）
NEWS_FETCH_TIMEOUT=12
# 一轮抓取全部源的总时间预算（秒）：超时未返回的源按失败处理，避免被单个慢源拖住
NEWS_SEARCH_DEADLINE=8
# 单个响应体上限（字节）
NEWS_HTTP_MAX_BYTES=3000000
# search_news 关键词模式默认返回条数上限
NEWS_SEARCH_MAX_ITEMS=12
# search_news 浏览模式（不传 keyword）单次返回上限：一次给全景，比关键词模式宽
NEWS_BROWSE_MAX_ITEMS=40
# fetch_article 返回正文上限（字符）
NEWS_ARTICLE_MAX_CHARS=6000
# 判定「同一条新闻」的标题相似度阈值（0~1）
NEWS_TITLE_SIMILARITY=0.9

# ---------- 第三阶段：简报生成 ----------
# 简报在 workspace 内的输出子目录
BRIEFING_OUTPUT_DIR=briefings
# 简报任务轮数上限（搜索步骤多，比通用任务宽松；硬上限仍为 20）
BRIEFING_MAX_STEPS=16
# 简报任务工具调用次数上限
BRIEFING_MAX_TOOL_CALLS=40
# 简报任务整体超时（秒）
BRIEFING_RUN_TIMEOUT=600

# 邮件推送（SMTP）
# 465 端口走 SSL 直连，587 端口走 STARTTLS，其它端口走明文（如本地假 SMTP / 内网中继）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
# 发件账号（QQ / 163 等需要使用「授权码」而不是登录密码）
SMTP_USER=
SMTP_PASSWORD=
# 发件人地址；留空则回退 SMTP_USER
SMTP_SENDER=
SMTP_FROM_NAME=AI 新闻助手
# 是否 SSL 直连：留空按端口自动判断（465→SSL，587→STARTTLS，其它→明文）
# SMTP_USE_SSL=
# SMTP 连接超时（秒）
SMTP_TIMEOUT=15

# ---------- 第四阶段：定时任务（APScheduler）----------
# 总开关；多进程部署（uvicorn --workers N）时只让一个进程开，否则同一时刻会触发 N 次
SCHEDULER_ENABLED=true
# 每天几点执行（24 小时制 HH:MM），写错会自动回退 08:00 并打告警
SCHEDULER_TIME=08:00
# 时区（IANA 名称）。决定「每天几点」以及任务归属哪一天
SCHEDULER_TIMEZONE=Asia/Shanghai
# 启动补跑：服务停机错过了执行时间，启动后自动补做当天未完成的任务
SCHEDULER_CATCH_UP=true
# 同时执行几个用户的生成任务（每个任务会打多次 LLM 请求 + 抓多个 RSS 源）
SCHEDULER_MAX_CONCURRENCY=2
# 错过触发点后仍允许补执行的宽限时间（秒）
SCHEDULER_MISFIRE_GRACE=3600
# 任务卡在 running 超过该分钟数视为「进程崩溃遗留」，允许被重新领取
SCHEDULER_STALE_MINUTES=30
# 僵尸任务回收作业的扫描间隔（分钟）：发现中断任务 → 标记失败 → 当天自动重派
SCHEDULER_RECOVERY_INTERVAL_MINUTES=10

# ---------- 第四阶段：邮件推送 ----------
# 全局推送开关（与用户级开关是「与」关系）
PUSH_ENABLED=true
# 邮件里「查看简报」入口的外网地址前缀（部署到服务器后改成公网域名）
PUSH_BASE_URL=http://127.0.0.1:8000
# 失败重试扫描间隔（分钟）
PUSH_RETRY_INTERVAL_MINUTES=10
# 最多尝试次数（含首次）
PUSH_MAX_ATTEMPTS=3
# 重试退避基数（秒）：第 n 次失败后等待 base * 2^(n-1)
PUSH_RETRY_BACKOFF_SECONDS=60
